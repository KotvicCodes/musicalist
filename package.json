{
  "name": "musicalist",
  "author": "Kotvič",
  "description": "Check README.md for all information",
  "keywords": [
    "song",
    "music",
    "metadata",
    "deezer",
    "musicbrainz",
    "acousticbrainz",
    "mood",
    "electron"
  ],
  "main": "dist/index.js",
  "version": "1.2.4",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "scripts": {
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.19.4",
    "electron": "^43.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 105,
    "trailingComma": "none"
  }
}
